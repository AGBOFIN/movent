# ==========================================================================
# MOVENT — variables d'environnement
# Copier en .env puis RENSEIGNER toutes les valeurs marquées « à changer ».
# Ne jamais committer le .env (déjà ignoré par Git).
# ==========================================================================

# --- Accès public ---------------------------------------------------------
# Domaine ou sous-domaine pour le HTTPS automatique (ex. movent.example.com).
# Alternative sans domaine : adresse IP de la VM (HTTP seul, pas de HTTPS),
# ou un sous-domaine gratuit DuckDNS (voir documentation/deploiement.md).
DOMAIN=a-changer.example.com
# E-mail pour les notifications Let's Encrypt (optionnel)
ACME_EMAIL=

# --- Secrets (OBLIGATOIRE : générer des valeurs fortes, jamais les défauts) --
# JWT : signature des tokens (>= 32 caractères aléatoires)
#   Générer : openssl rand -hex 32
JWT_SECRET=a-changer-32-octets-minimum
# Clé des appels internes entre microservices (hold / confirm-hold / release-hold)
#   Générer : openssl rand -hex 32
INTERNAL_API_KEY=a-changer-32-octets-minimum
# Clé de chiffrement Laravel : laisser VIDE, une clé est générée au démarrage
APP_KEY=
# URL publique de la plateforme (laisser vide : déduite de DOMAIN)
APP_URL=

# --- Mots de passe des 3 bases PostgreSQL (un par base, à changer) --------
USERS_DB_PASSWORD=a-changer-db-users
EVENTS_DB_PASSWORD=a-changer-db-events
BOOKINGS_DB_PASSWORD=a-changer-db-bookings

# --- Réglages --------------------------------------------------------------
# Durée de blocage des places pendant le paiement (minutes)
HOLD_MINUTES=10

# --- docker-compose.yml LOCAL uniquement (non utilisé par docker-compose.prod.yml)
# Port d'écoute de la gateway Nginx en local
GATEWAY_PORT=8080
